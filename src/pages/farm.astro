---
import Base from '../layouts/Base.astro';
import { HONEYS } from '../data/honeys';
---
<Base title="The farm">
  <section class="head wrap">
    <p class="eyebrow">The farm</p>
    <h1 class="serif">One beekeeper. Four places the nectar is best.</h1>
    <p class="lede">Hunny Farm honey is gathered by [BEEKEEPER NAME], a beekeeper who follows the bloom. Some of it comes from hives in Wisconsin's Driftless. Some of it rides back from the Florida Panhandle each spring. All of it is raw and unfiltered, and we bottle it ourselves, by hand, in Lake County, Illinois.</p>
  </section>
  <section class="places wrap">
    {HONEYS.map((h) => (
      <div class="place reveal" style={`--bg:${h.color}; --fg:${h.ink}`}>
        <div class="grain"></div>
        <p class="eyebrow">No. {h.number}</p>
        <h2 class="serif">{h.origin}</h2>
        <p class="src">{h.source} · {h.season}</p>
        <p class="blurb">{h.blurb}</p>
        <a href={`/honey/${h.slug}`} class="link">{h.name} Honey →</a>
      </div>
    ))}
  </section>
  <section class="photo-row wrap">
    <img class="photo" src="/journal/three-weeks-in-june.webp" alt="A row of hives below a hillside of blooming basswood trees." width="1536" height="1024" loading="lazy" decoding="async" />
    <img class="photo" src="/journal/bottling-day.webp" alt="Honey running from a bottling bucket into a glass jar in a small workroom." width="1536" height="1024" loading="lazy" decoding="async" />
    <img class="photo" src="/journal/honey-field-inspection.webp" alt="A beekeeper in a white suit lifts a frame of honeycomb from a hive in a clover field." width="1536" height="1024" loading="lazy" decoding="async" />
  </section>
</Base>
<style>
  .head { padding-top: clamp(24px, 4vw, 48px); padding-bottom: 48px; display: flex; flex-direction: column; gap: 18px; max-width: 900px; }
  .head .eyebrow { opacity: 0.7; }
  .head h1 { font-size: clamp(40px, 6.6vw, 96px); line-height: 0.94; font-weight: 500; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  .lede { font-size: 18px; line-height: 1.6; opacity: 0.85; text-wrap: pretty; }
  .places { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-bottom: 24px; }
  .place { position: relative; overflow: hidden; background: var(--bg); color: var(--fg); padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; gap: 12px; }
  .place .eyebrow { opacity: 0.8; }
  .place h2 { font-size: clamp(30px, 3vw, 44px); line-height: 1; font-weight: 500; margin: 0; }
  .src { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
  .blurb { font-size: 16px; line-height: 1.55; }
  .link { font-size: 14px; font-weight: 600; margin-top: 8px; padding: 10px 0; align-self: flex-start; }
  .photo-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding-bottom: clamp(64px, 8vw, 120px); }
  .photo { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; background: #E9D9B0; }
  @media (max-width: 720px) { .places, .photo-row { grid-template-columns: 1fr; } }
</style>
