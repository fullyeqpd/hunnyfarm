---
import Base from '../../layouts/Base.astro';
import Jar from '../../components/Jar.astro';
import PostCard from '../../components/PostCard.astro';
import { HONEYS } from '../../data/honeys';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const h = HONEYS.find((x) => x.slug === post.data.honey)!;
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const more = all.filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base title={post.data.title} description={post.data.dek} theme={h.color}>
  <article>
    <header class="hero wrap" style={`--bg:${h.color}; --fg:${h.ink}`}>
      <div class="grain"></div>
      <div class="hero-text">
        <p class="eyebrow">{post.data.kicker} · {date} · {post.data.readingTime} read</p>
        <h1 class="serif">{post.data.title}</h1>
        <p class="dek">{post.data.dek}</p>
      </div>
      <div class="hero-art"><Jar slug={h.slug} name={h.name} notes={h.notes} width={260} shadow float /></div>
    </header>
    <div class="body wrap">
      <div class="prose"><Content /></div>
      <p class="author">{post.data.author}, Hunny Farm</p>
    </div>
  </article>
  <section class="more wrap">
    <p class="eyebrow">Keep reading</p>
    <div class="grid">{more.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
<style>
  .hero { position: relative; overflow: hidden; background: var(--bg); color: var(--fg); display: grid; grid-template-columns: 1fr minmax(0, 420px); gap: 48px; align-items: center; padding-top: clamp(48px, 5vw, 72px); padding-bottom: clamp(48px, 5vw, 72px); }
  .hero-text { display: flex; flex-direction: column; gap: 20px; position: relative; }
  .hero .eyebrow { opacity: 0.8; }
  .hero h1 { font-size: clamp(40px, 6vw, 88px); line-height: 0.96; font-weight: 500; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  .dek { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.5; opacity: 0.9; max-width: 640px; text-wrap: pretty; }
  .hero-art { display: flex; justify-content: center; position: relative; }
  @media (max-width: 720px) { .hero { grid-template-columns: 1fr; } .hero-art { order: -1; } .hero-art :global(.jar) { width: 180px; } }
  .body { max-width: calc(680px + 2 * var(--gutter)); margin: 0 auto; padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(48px, 6vw, 80px); }
  .author { margin-top: 40px; font-size: 14px; opacity: 0.7; }
  .more { padding-bottom: clamp(64px, 8vw, 120px); display: flex; flex-direction: column; gap: 24px; }
  .more .eyebrow { opacity: 0.7; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
