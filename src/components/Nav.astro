---
const path = Astro.url.pathname;
const links = [
  ['/#honeys', 'Our honeys'],
  ['/farm', 'The farm'],
  ['/journal', 'Journal'],
];
---
<header class="nav">
  <a href="/" class="home"><img class="seal" src="/brand/seal-gold.svg" alt="" width="44" height="44" decoding="async" /><span class="serif wordmark">Hunny Farm</span></a>
  <nav>
    {links.map(([href, label]) => <a href={href} aria-current={path.startsWith(href.replace('/#honeys','/x')) ? 'page' : undefined}>{label}</a>)}
  </nav>
  <a href="/#honeys" class="cart">Shop</a>
</header>
<style>
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px var(--gutter-nav); }
  .home { display: flex; align-items: center; gap: 14px; }
  .seal { width: 44px; height: 44px; display: block; }
  .wordmark { font-size: clamp(20px, 2vw, 26px); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  nav { display: flex; gap: clamp(18px, 3vw, 36px); font-size: 14px; font-weight: 500; }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .cart { font-size: 14px; font-weight: 500; }
  /* Touch: keep links reachable, give them a real tap area */
  nav a, .cart { padding: 10px 0; }
  @media (max-width: 600px) {
    .nav { flex-wrap: wrap; row-gap: 0; padding-top: 16px; padding-bottom: 12px; }
    .home { flex: 1; gap: 10px; }
    .seal { width: 36px; height: 36px; }
    nav { order: 3; flex-basis: 100%; gap: 22px; font-size: 13px; letter-spacing: 0.02em; }
    nav a { padding: 8px 0; }
  }
</style>
